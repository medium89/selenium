FAST_MODE=1 # отключает паузы pause_action и подсветку
HIGHLIGHT_UI=0 # отдельно отключить подсветку
DEBUG_ARTIFACTS=0 # не делать DOM/скриншоты
DUMP_DOM_EACH_PAGE=0 # не сохранять DOM на каждой странице
WAIT_DOCS_TIMEOUT=15 # уменьшить таймаут ожидания списка
WAIT_DOCS_POST_DELAY=0 # убрать sleep(1) после загрузки списка